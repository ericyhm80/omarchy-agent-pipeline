#!/usr/bin/env python3
"""agent-pipeline — record what an AI agent did, for the Omarchy bar widget.

Storage: $XDG_STATE_HOME/omarchy/agent-pipeline/requests.json
  {"updatedAt": ISO, "requests": [ {id, at, title, agent, state, taskClass,
   route, model, tokens{input,output,cacheRead,costUsd}, steps[{name,status,detail,ms}]} ]}
Newest request last; the file is rewritten atomically and capped, so the bar
widget can watch a single path.

Typical use from an agent runtime:
  agent-pipeline start --id "$REQ" --title "定价决策" --agent entrepreneur-agent
  agent-pipeline step  --id "$REQ" --name classify --status ok --detail "strategy (rules)" --ms 3
  agent-pipeline step  --id "$REQ" --name model    --status ok --detail "glm-5.3-flash" --ms 8200
  agent-pipeline signal --id "$REQ" --dimension robustness --kind fallback_used --level info \
      --detail "z.ai 502, continued on GLM"
  agent-pipeline signal --id "$REQ" --dimension security --kind human_gate_bypass --level error \
      --detail "L2 decision sent without sign-off"
  agent-pipeline end   --id "$REQ" --state done --tokens-json '{"input":1200,"output":90,"cacheRead":4000,"costUsd":0.002}' \
      --metrics-json '{"toolCalls":5,"apiCalls":3,"retries":1}' --env-json '{"provider":"z.ai","sandbox":true}'

`signal` is how a runtime reports the architecture's stability, robustness and
security: the widget scores those three dimensions from the signals and run
outcomes (see README). A dimension with no signals reads n/a, never 100.

Nothing here writes outside the state directory; failures are silent by design
so instrumentation can never break the agent it is observing.
"""
from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
from pathlib import Path

STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
STORE = STATE_HOME / "omarchy" / "agent-pipeline" / "requests.json"
MAX_REQUESTS = 30
# Facts are bounded like everything else here: a run with more tool calls than this
# keeps its newest entries. The robustness penalty is capped per request anyway
# (Model.js HEALTH.robustness.cap), so truncation can only affect runs that have
# already hit the cap.
TOOL_LOG_MAX = 400

# Shipped default architecture: the pipeline this widget was built around. Data
# can override it entirely, so the widget stays useful for other runtimes.
DEFAULT_ARCHITECTURE = {
    # Compact 5x3 grid; coordinates are data, so a runtime can lay out its own graph.
    "width": 712,
    "height": 236,
    "nodes": [
        {"id": "input",      "label": "Input",           "x": 6,   "y": 96,  "w": 122, "h": 42},
        {"id": "router",     "label": "Classify + Route", "x": 146, "y": 96,  "w": 128, "h": 42},
        {"id": "context",    "label": "Context",         "x": 292, "y": 12,  "w": 122, "h": 42},
        {"id": "memory",     "label": "Memory",          "x": 292, "y": 96,  "w": 122, "h": 42},
        {"id": "model",      "label": "Model",           "x": 292, "y": 180, "w": 122, "h": 42},
        {"id": "tools",      "label": "Tools",           "x": 432, "y": 138, "w": 118, "h": 42},
        {"id": "verify",     "label": "Verify",          "x": 432, "y": 54,  "w": 118, "h": 42},
        {"id": "human_gate", "label": "Human Gate",      "x": 584, "y": 180, "w": 122, "h": 42},
        {"id": "output",     "label": "Output",          "x": 584, "y": 54,  "w": 122, "h": 42},
    ],
    "edges": [
        {"from": "input", "to": "router"},
        {"from": "router", "to": "context", "label": "context"},
        {"from": "router", "to": "memory", "label": "retrieve"},
        {"from": "context", "to": "model"},
        {"from": "memory", "to": "model"},
        {"from": "model", "to": "tools", "label": "needs tools"},
        {"from": "model", "to": "verify", "label": "answer"},
        {"from": "tools", "to": "verify"},
        {"from": "verify", "to": "output"},
        {"from": "verify", "to": "human_gate", "label": "needs human"},
    ],
}


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def load() -> dict:
    if not STORE.exists():
        return {"updatedAt": now(), "requests": [], "architecture": DEFAULT_ARCHITECTURE}
    try:
        data = json.loads(STORE.read_text(encoding="utf-8"))
        if not isinstance(data, dict) or not isinstance(data.get("requests"), list):
            raise ValueError("bad shape")
        data.setdefault("architecture", DEFAULT_ARCHITECTURE)
        return data
    except (json.JSONDecodeError, OSError, ValueError):
        return {"updatedAt": now(), "requests": [], "architecture": DEFAULT_ARCHITECTURE}


def save(data: dict) -> None:
    data["updatedAt"] = now()
    data["requests"] = data["requests"][-MAX_REQUESTS:]
    refresh_instrument(data)
    STORE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STORE.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(tmp, STORE)


# --- instrument self-report --------------------------------------------------
# The runtime publishes which extension code it LOADED (id, version, time, pid);
# this writer records what is on disk NOW next to it. A live process keeps the code
# it loaded until pi reloads or restarts, so "the file is fixed" and "the running
# agent uses the fix" are two different claims - measured 2026-10-03, when a process
# holding the old extension reported tool failures with no recovery for 40 minutes
# after the fix landed. Without this pair the panel shows scores from an instrument
# nobody can name, and the number looks like a property of the agent.
EXTENSION_PATH = Path(os.environ.get("PI_AGENT_PIPELINE_EXTENSION")
                      or (Path.home() / ".pi" / "agent" / "extensions" / "agent-pipeline.ts"))
VERSION_RE = re.compile(r'EXT_VERSION\s*=\s*"([^"]+)"')


def disk_instrument() -> dict | None:
    """What the extension file on disk says about itself right now."""
    try:
        raw = EXTENSION_PATH.read_bytes()
        mtime = EXTENSION_PATH.stat().st_mtime
    except OSError:
        return None
    match = VERSION_RE.search(raw.decode("utf-8", "replace"))
    return {"version": match.group(1) if match else "",
            "sha256": hashlib.sha256(raw).hexdigest(),
            "mtime": dt.datetime.fromtimestamp(mtime, dt.timezone.utc).isoformat().replace("+00:00", "Z"),
            "path": str(EXTENSION_PATH),
            "checkedAt": now()}


def refresh_instrument(data: dict) -> None:
    """Refresh the disk side next to whatever the runtime reported loading."""
    disk = disk_instrument()
    ins = data.get("instrument")
    if not isinstance(ins, dict):
        if disk is None:
            return
        ins = data["instrument"] = {}
    ins["disk"] = disk


def with_lock(fn):
    STORE.parent.mkdir(parents=True, exist_ok=True)
    lock_path = STORE.with_suffix(".lock")
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            return fn()
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def find(data: dict, request_id: str) -> dict | None:
    for row in data["requests"]:
        if row.get("id") == request_id:
            return row
    return None


def blank(rid: str) -> dict:
    return {"id": rid, "at": now(), "title": "", "agent": "", "state": "running",
            "taskClass": "", "route": "", "model": "",
            "tokens": {"input": 0, "output": 0, "cacheRead": 0, "costUsd": 0.0},
            "nodes": [], "edges": [], "issues": [], "signals": [], "toolLog": []}


def parse_ts(value):
    """A recorded time in any shape this pipeline sees → aware UTC datetime.

    pi writes epoch-milliseconds for tool results; this store writes ISO strings.
    Booleans are rejected on purpose: `True` is not a timestamp, and silently
    treating it as one would invent a time.
    """
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        seconds = (value / 1000.0) if abs(value) > 1e11 else float(value)
        try:
            return dt.datetime.fromtimestamp(seconds, dt.timezone.utc)
        except (OverflowError, OSError, ValueError):
            return None
    text = str(value or "").strip()
    if not text:
        return None
    try:
        parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=dt.timezone.utc)


def load_session_facts(path: Path) -> list[dict]:
    """Tool results recorded by pi itself: [{at, tool, ok}] in file order.

    The session log is independent evidence: it survives the instrumentation being
    reloaded, replaced or never loaded at all. Undecodable lines are skipped, never
    guessed at.
    """
    facts: list[dict] = []
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(entry, dict) or entry.get("type") != "message":
                continue
            msg = entry.get("message") or {}
            if msg.get("role") != "toolResult":
                continue
            at = parse_ts(msg.get("timestamp"))
            if at is None:
                continue
            facts.append({"at": at, "tool": str(msg.get("toolName") or "tool"),
                          "ok": not msg.get("isError")})
    return facts


def uncancelled_tool_failures(log: list[dict]) -> int:
    """How many recorded tool failures no later success of the SAME tool absorbed.

    Deliberately the same rule as the widget's Model.js: one success cancels one
    outstanding failure per tool name, first-come-first-cancelled. Kept here so the
    dry run can say what the scorer will conclude *before* anything is written.
    """
    pending: dict[str, int] = {}
    for entry in log:
        tool = str((entry or {}).get("tool") or "tool")
        if (entry or {}).get("ok"):
            if pending.get(tool):
                pending[tool] -= 1
            continue
        pending[tool] = pending.get(tool, 0) + 1
    return sum(n for n in pending.values() if n > 0)


def main() -> int:
    p = argparse.ArgumentParser(prog="agent-pipeline")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start", help="open a request")
    s.add_argument("--id", required=True)
    s.add_argument("--title", default="")
    s.add_argument("--agent", default="")
    s.add_argument("--task-class", dest="task_class", default="")
    s.add_argument("--route", default="")
    s.add_argument("--model", default="")

    st = sub.add_parser("step", help="append one pipeline step")
    st.add_argument("--id", required=True)
    st.add_argument("--name", required=True)
    st.add_argument("--status", default="ok")
    st.add_argument("--detail", default="")
    st.add_argument("--ms", type=float, default=0.0)

    e = sub.add_parser("end", help="close a request")
    e.add_argument("--id", required=True)
    e.add_argument("--state", default="done", choices=["done", "error", "running"])
    e.add_argument("--tokens-json", dest="tokens_json", default=None)
    e.add_argument("--model", default=None)
    e.add_argument("--route", default=None)
    e.add_argument("--task-class", dest="task_class", default=None)
    e.add_argument("--duration-ms", dest="duration_ms", type=float, default=None)
    e.add_argument("--summary", default=None)
    e.add_argument("--metrics-json", dest="metrics_json", default=None)
    e.add_argument("--env-json", dest="env_json", default=None)

    em = sub.add_parser("emit", help="append a complete request object (JSON)")
    em.add_argument("json")

    a = sub.add_parser("architecture", help="set the workflow graph (nodes + edges)")
    a.add_argument("--json", default=None, help="graph JSON; omit to reset to the shipped default")
    a.add_argument("--file", default=None, help="read graph JSON from a file")

    n = sub.add_parser("node", help="record one workflow node's state for a request")
    n.add_argument("--id", required=True)
    n.add_argument("--node", required=True)
    n.add_argument("--status", default="ok")
    n.add_argument("--detail", default="")
    n.add_argument("--ms", type=float, default=0.0)
    n.add_argument("--tokens-json", dest="tokens_json", default=None)

    pt = sub.add_parser("patch", help="merge a JSON patch into one request (single process)")
    pt.add_argument("json")
    pt.add_argument("--file", default=None, help="read the patch JSON from a file instead")

    i = sub.add_parser("issue", help="record a problem encountered during a request")
    i.add_argument("--id", required=True)
    i.add_argument("--level", default="warn", choices=["warn", "error", "info"])
    i.add_argument("--node", default="")
    i.add_argument("--detail", required=True)

    sg = sub.add_parser("signal", help="record one stability/robustness/security observation")
    sg.add_argument("--id", required=True)
    sg.add_argument("--dimension", required=True, choices=["stability", "robustness", "security"])
    sg.add_argument("--kind", required=True)
    sg.add_argument("--level", default="warn", choices=["info", "warn", "error"])
    sg.add_argument("--detail", default="")
    sg.add_argument("--node", default="")
    sg.add_argument("--weight", type=float, default=None,
                    help="override the default penalty for this kind (see the widget's Model.js)")

    rc = sub.add_parser("reconcile", help="write missing tool FACTS from a pi session log "
                                           "(dry run unless --apply)")
    rc.add_argument("--session-log", dest="session_log", required=True,
                    help="pi session JSONL (the runtime's own record of every tool result)")
    rc.add_argument("--id", action="append", default=None,
                    help="request id to reconcile; repeatable. Omit to use --window")
    rc.add_argument("--window", type=int, default=20,
                    help="how many of the newest requests to consider (default 20, the scored window)")
    rc.add_argument("--apply", action="store_true",
                    help="write the reconstructed facts (backs the store up first)")
    rc.add_argument("--dry-run", dest="dry_run", action="store_true",
                    help="explicitly do NOT write anything (this is the default; passing it with "
                         "--apply is refused rather than guessed at)")
    rc.add_argument("--verify", action="store_true",
                    help="for requests that ALREADY carry facts, re-derive them and compare")
    rc.add_argument("--json", action="store_true", help="machine-readable report")

    sub.add_parser("clear", help="remove all recorded requests")
    sub.add_parser("demo", help="write one sample pipeline for a first look")

    args = p.parse_args()

    if args.cmd == "start":
        def op() -> int:
            data = load()
            if find(data, args.id) is None:
                data["requests"].append({
                    "id": args.id, "at": now(), "title": args.title, "agent": args.agent,
                    "state": "running", "taskClass": args.task_class, "route": args.route,
                    "model": args.model,
                    "tokens": {"input": 0, "output": 0, "cacheRead": 0, "costUsd": 0.0},
                    "steps": [],
                })
                save(data)
            return 0
        return with_lock(op)

    if args.cmd == "step":
        def op() -> int:
            data = load()
            row = find(data, args.id)
            if row is None:
                row = {"id": args.id, "at": now(), "title": "", "agent": "", "state": "running",
                       "taskClass": "", "route": "", "model": "",
                       "tokens": {"input": 0, "output": 0, "cacheRead": 0, "costUsd": 0.0},
                       "steps": [], "toolLog": []}
                data["requests"].append(row)
            row.setdefault("steps", []).append({
                "name": args.name, "status": args.status, "detail": args.detail, "ms": round(args.ms, 1),
            })
            row["state"] = "error" if args.status in ("error", "failed") else row.get("state", "running")
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "end":
        def op() -> int:
            data = load()
            row = find(data, args.id)
            if row is None:
                return 0
            row["state"] = "error" if args.state == "error" else ("running" if args.state == "running" else "done")
            if args.tokens_json:
                try:
                    row["tokens"] = json.loads(args.tokens_json)
                except json.JSONDecodeError:
                    pass
            if args.model:
                row["model"] = args.model
            if args.route:
                row["route"] = args.route
            if args.task_class:
                row["taskClass"] = args.task_class
            if args.duration_ms is not None:
                row["durationMs"] = round(args.duration_ms, 1)
            if args.summary:
                row["summary"] = args.summary
            if args.metrics_json:
                try:
                    row["metrics"] = {**(row.get("metrics") or {}), **json.loads(args.metrics_json)}
                except json.JSONDecodeError:
                    pass
            if args.env_json:
                try:
                    row["env"] = {**(row.get("env") or {}), **json.loads(args.env_json)}
                except json.JSONDecodeError:
                    pass
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "emit":
        def op() -> int:
            try:
                row = json.loads(args.json)
            except json.JSONDecodeError:
                return 1
            data = load()
            data["requests"] = [r for r in data["requests"] if r.get("id") != row.get("id")]
            data["requests"].append(row)
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "architecture":
        def op() -> int:
            data = load()
            if args.file:
                try:
                    data["architecture"] = json.loads(Path(args.file).read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError):
                    return 1
            elif args.json:
                try:
                    data["architecture"] = json.loads(args.json)
                except json.JSONDecodeError:
                    return 1
            else:
                data["architecture"] = DEFAULT_ARCHITECTURE
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "node":
        def op() -> int:
            data = load()
            row = find(data, args.id)
            if row is None:
                row = {"id": args.id, "at": now(), "title": "", "agent": "", "state": "running",
                       "taskClass": "", "route": "", "model": "",
                       "tokens": {"input": 0, "output": 0, "cacheRead": 0, "costUsd": 0.0},
                       "nodes": [], "edges": [], "issues": []}
                data["requests"].append(row)
            row.setdefault("nodes", [])
            tokens = None
            if args.tokens_json:
                try:
                    tokens = json.loads(args.tokens_json)
                except json.JSONDecodeError:
                    tokens = None
            row["nodes"] = [n for n in row["nodes"] if n.get("id") != args.node]
            entry = {"id": args.node, "status": args.status, "detail": args.detail, "ms": round(args.ms, 1)}
            if tokens:
                entry["tokens"] = tokens
            row["nodes"].append(entry)
            # every recorded node implies the edge that fed it was traversed
            for edge in (data.get("architecture") or {}).get("edges", []):
                if edge.get("to") == args.node:
                    pair = {"from": edge["from"], "to": edge["to"]}
                    if pair not in row.setdefault("edges", []):
                        row["edges"].append(pair)
            if args.status in ("error", "failed"):
                row["state"] = "error"
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "patch":
        def op() -> int:
            raw = args.json
            if args.file:
                try:
                    raw = Path(args.file).read_text(encoding="utf-8")
                except OSError:
                    return 1
            try:
                patch = json.loads(raw)
            except json.JSONDecodeError:
                return 1
            data = load()
            if isinstance(patch.get("instrument"), dict):
                loaded = {k: v for k, v in patch["instrument"].items() if k != "disk"}
                current = data.get("instrument")
                if not isinstance(current, dict):
                    current = data["instrument"] = {}
                current.update(loaded)
                current["seenAt"] = now()
            rid = str(patch.get("id") or "")
            if not rid:
                return 1
            row = find(data, rid)
            if row is None:
                row = {"id": rid, "at": now(), "title": "", "agent": "", "state": "running",
                       "taskClass": "", "route": "", "model": "",
                       "tokens": {"input": 0, "output": 0, "cacheRead": 0, "costUsd": 0.0},
                       "nodes": [], "edges": [], "issues": [], "toolLog": []}
                data["requests"].append(row)
            if isinstance(patch.get("architecture"), dict):
                row["architecture"] = patch["architecture"]
            for key in ("title", "agent", "state", "taskClass", "route", "model", "summary"):
                if patch.get(key) is not None:
                    row[key] = patch[key]
            if patch.get("durationMs") is not None:
                row["durationMs"] = round(float(patch["durationMs"]), 1)
            if isinstance(patch.get("tokens"), dict):
                row["tokens"] = patch["tokens"]
            row.setdefault("nodes", [])
            for node in patch.get("nodes") or []:
                if not node.get("id"):
                    continue
                row["nodes"] = [n for n in row["nodes"] if n.get("id") != node["id"]]
                row["nodes"].append(node)
                for edge in (data.get("architecture") or {}).get("edges", []):
                    if edge.get("to") == node["id"]:
                        pair = {"from": edge["from"], "to": edge["to"]}
                        if pair not in row.setdefault("edges", []):
                            row["edges"].append(pair)
                if node.get("status") in ("error", "failed"):
                    row["state"] = "error"
            for issue in patch.get("issues") or []:
                row.setdefault("issues", []).append(issue)
            if isinstance(patch.get("env"), dict):
                row["env"] = {**(row.get("env") or {}), **patch["env"]}
            if isinstance(patch.get("metrics"), dict):
                row["metrics"] = {**(row.get("metrics") or {}), **patch["metrics"]}
            for sig in patch.get("signals") or []:
                if isinstance(sig, dict):
                    row.setdefault("signals", []).append(sig)
            facts = patch.get("toolLog")
            if isinstance(facts, list):
                entries = [e for e in facts if isinstance(e, dict) and e.get("tool")]
                if entries:
                    merged = list(row.get("toolLog") or []) + entries
                    row["toolLog"] = merged[-TOOL_LOG_MAX:]
            if isinstance(patch.get("toolLogSource"), str):
                row["toolLogSource"] = patch["toolLogSource"]
            if patch.get("archReset"):
                data["architecture"] = DEFAULT_ARCHITECTURE
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "issue":
        def op() -> int:
            data = load()
            row = find(data, args.id)
            if row is None:
                return 0
            row.setdefault("issues", []).append({
                "level": args.level, "node": args.node, "detail": args.detail, "at": now(),
            })
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "signal":
        def op() -> int:
            data = load()
            row = find(data, args.id)
            if row is None:
                row = blank(args.id)
                data["requests"].append(row)
            entry = {"dimension": args.dimension, "kind": args.kind, "level": args.level,
                     "detail": args.detail, "at": now()}
            if args.node:
                entry["node"] = args.node
            if args.weight is not None:
                entry["weight"] = args.weight
            row.setdefault("signals", []).append(entry)
            save(data)
            return 0
        return with_lock(op)

    if args.cmd == "reconcile":
        if args.apply and args.dry_run:
            print("error: --apply and --dry-run contradict each other; refusing", file=sys.stderr)
            return 1

        def op() -> int:
            path = Path(args.session_log)
            if not path.is_file():
                print(f"error: no session log at {path}", file=sys.stderr)
                return 1
            try:
                facts = load_session_facts(path)
            except OSError as exc:
                print(f"error: cannot read session log: {exc}", file=sys.stderr)
                return 1
            data = load()
            rows = data["requests"]
            if args.id:
                wanted = {str(i) for i in args.id}
                targets = [(i, r) for i, r in enumerate(rows) if str(r.get("id")) in wanted]
                for miss in sorted(wanted - {str(r.get("id")) for _, r in targets}):
                    print(f"note: no such request: {miss}", file=sys.stderr)
            else:
                targets = list(enumerate(rows))[max(0, len(rows) - args.window):]

            def shape(entries) -> str:
                return "".join("." if (e or {}).get("ok") else "X" for e in entries)

            report: list[dict] = []
            writing = 0
            for _, row in targets:
                rid = str(row.get("id") or "")
                start = parse_ts(row.get("at"))
                duration = row.get("durationMs")
                end = (start + dt.timedelta(milliseconds=float(duration))
                       if (start is not None and duration is not None) else None)
                window = [f for f in facts if start <= f["at"] <= end] if (start is not None and end is not None) else []
                derived = [{"tool": f["tool"], "ok": f["ok"]} for f in window]
                existing = [e for e in (row.get("toolLog") or []) if isinstance(e, dict) and e.get("tool")]
                sigs = row.get("signals") or []
                sig_fail = sum(1 for s in sigs if str((s or {}).get("kind")) == "tool_failure")
                sig_rec = sum(1 for s in sigs if str((s or {}).get("kind")) == "tool_recovered")
                item = {
                    "id": rid, "at": str(row.get("at") or ""), "state": str(row.get("state") or ""),
                    "window": None if end is None else f"{start.isoformat()}..{end.isoformat()}",
                    "toolResults": len(derived),
                    "failures": sum(1 for f in derived if not f["ok"]),
                    "uncancelled": uncancelled_tool_failures(derived),
                    "signals": {"tool_failure": sig_fail, "tool_recovered": sig_rec},
                    "existingFacts": len(existing),
                    "action": "none",
                }
                if existing:
                    if args.verify:
                        if not derived:
                            item["action"] = "verify-not-reconstructable"
                        elif len(existing) == len(derived) and shape(existing) == shape(derived):
                            item["action"] = "verify-match"
                        else:
                            item["action"] = "verify-MISMATCH"
                            item["recorded"] = shape(existing)[:120]
                            item["derived"] = shape(derived)[:120]
                    else:
                        item["action"] = "keep-existing-facts"
                elif start is None or end is None:
                    item["action"] = "skip-no-window"
                elif not derived:
                    item["action"] = "skip-no-tool-results"
                    if sig_fail or sig_rec:
                        item["warning"] = ("record claims tool signals but the session log shows no "
                                           "tool result inside its window")
                else:
                    item["action"] = "would-write-facts"
                    if args.apply:
                        row["toolLog"] = derived
                        row["toolLogSource"] = (f"reconstructed from {path.name} "
                                                f"[{start.isoformat()}..{end.isoformat()}] "
                                                f"by agent-pipeline reconcile {now()}")
                        item["action"] = "wrote-facts"
                        writing += 1
                report.append(item)

            backup = None
            if args.apply and writing:
                stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
                backup = STORE.with_name(STORE.name + f".bak-{stamp}")
                if backup.exists():
                    print(f"error: refusing to overwrite existing backup {backup}", file=sys.stderr)
                    return 1
                shutil.copy2(STORE, backup)
                save(data)

            if args.json:
                print(json.dumps({"sessionLog": str(path), "totalToolResults": len(facts),
                                  "write": bool(args.apply), "backup": str(backup) if backup else None,
                                  "rows": report}, ensure_ascii=False, indent=2))
                return 0
            print(f"session log: {path} ({len(facts)} tool result(s) recorded)")
            for item in report:
                extra = ""
                if item["action"] == "verify-MISMATCH":
                    extra = f" recorded={item['recorded']} derived={item['derived']}"
                if item.get("warning"):
                    extra += "  ! " + item["warning"]
                print(f"  {item['id']:<28} {item['state']:<8} toolResults={item['toolResults']:<3} "
                      f"failures={item['failures']:<2} uncancelled={item['uncancelled']:<2} "
                      f"signals(tf={item['signals']['tool_failure']},tr={item['signals']['tool_recovered']}) "
                      f"facts={item['existingFacts']:<3} {item['action']}{extra}")
            if args.apply:
                print(f"wrote facts for {writing} request(s)" + (f"; backup {backup}" if backup else ""))
            else:
                print("dry run: nothing written (pass --apply to write the reconstructed facts)")
            return 0
        return with_lock(op)

    if args.cmd == "clear":
        def op() -> int:
            save({"updatedAt": now(), "requests": []})
            return 0
        return with_lock(op)

    if args.cmd == "demo":
        def op() -> int:
            data = load()
            data["architecture"] = DEFAULT_ARCHITECTURE
            data["requests"].append({
                "id": "demo-" + dt.datetime.now().strftime("%H%M%S"),
                "at": now(), "title": "Review the pricing strategy", "agent": "entrepreneur-agent",
                "state": "done", "taskClass": "strategy", "route": "strong",
                "model": "zai/glm-5.3-highspeed",
                "tokens": {"input": 1240, "output": 96, "cacheRead": 4180, "costUsd": 0.0023},
                "durationMs": 8260.0,
                "nodes": [
                    {"id": "input", "status": "ok", "detail": "1 command", "ms": 0},
                    {"id": "router", "status": "ok", "detail": "strategy → strong", "ms": 3},
                    {"id": "context", "status": "ok", "detail": "shared context 1.8k chars", "ms": 4},
                    {"id": "memory", "status": "ok", "detail": "5 items retrieved", "ms": 130},
                    {"id": "model", "status": "ok", "detail": "glm-5.3-highspeed", "ms": 8100},
                    {"id": "tools", "status": "skipped", "detail": "no tools needed", "ms": 0},
                    {"id": "verify", "status": "ok", "detail": "telemetry recorded", "ms": 3},
                    {"id": "output", "status": "ok", "detail": "returned", "ms": 0},
                ],
                "edges": [
                    {"from": "input", "to": "router"}, {"from": "router", "to": "context"},
                    {"from": "router", "to": "memory"}, {"from": "context", "to": "model"},
                    {"from": "memory", "to": "model"}, {"from": "model", "to": "verify"},
                    {"from": "verify", "to": "output"},
                ],
                "issues": [
                    {"level": "warn", "node": "model", "detail": "codex hit its usage limit, fell back to GLM"},
                ],
                "summary": "pricing review complete",
            })
            save(data)
            return 0
        return with_lock(op)

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception:  # instrumentation must never break the caller
        sys.exit(0)
